# /etc/nginx/sites-available/trcustoms-staging on the server, with
# @ADMIN_DIR@ the ADMIN_DIR of /srv/trcustoms-staging/env; see
# deploy/README.md. Staging asks for the password in
# /etc/nginx/auth.params everywhere but /uploads, and so does its mail
# catcher, which keeps the address it had as MailHog.
server {
    listen 80;
    server_name staging.trcustoms.org mailhog.trcustoms.org;
    include snippets/acme.conf;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    server_name staging.trcustoms.org;
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/trcustoms.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trcustoms.org/privkey.pem;
    include snippets/acme.conf;
    client_max_body_size 0;

    auth_basic "That's not the tomb you're looking for";
    auth_basic_user_file auth.params;

    root /srv/trcustoms-staging/www/current;

    location = /robots.txt {
        auth_basic off;
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        error_page 418 = @social_preview;
        if ($social_preview_ua = 1) {
            return 418;
        }
        try_files $uri $uri/ /index.html;
    }

    location @social_preview {
        include snippets/trcustoms-proxy.conf;
        proxy_set_header X-Social-Preview 1;
        proxy_pass http://unix:/srv/trcustoms-staging/run/web.sock;
    }

    location ~ ^/(@ADMIN_DIR@|api)(/.*)?$ {
        include snippets/trcustoms-proxy.conf;
        proxy_pass http://unix:/srv/trcustoms-staging/run/web.sock;
    }

    location /uploads/ {
        auth_basic off;
        add_header X-Content-Type-Options "nosniff" always;
        alias /srv/trcustoms-staging/data/uploads/;
    }

    location /django_static/ {
        add_header X-Content-Type-Options "nosniff" always;
        alias /srv/trcustoms-staging/data/django_static/;
    }
}

server {
    server_name mailhog.trcustoms.org;
    listen 443 ssl http2;
    ssl_certificate /etc/letsencrypt/live/trcustoms.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trcustoms.org/privkey.pem;
    include snippets/acme.conf;

    auth_basic "closed area";
    auth_basic_user_file auth.params;

    location / {
        include snippets/trcustoms-proxy.conf;
        proxy_pass http://unix:/srv/trcustoms-staging/run/mailpit.sock;
    }
}
